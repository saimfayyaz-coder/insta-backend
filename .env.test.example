# Test environment for E2E runs. Copy to .env.test (gitignored) and fill in.
# Same as .env, except the database name and NODE_ENV.

PORT=5000

# Same cluster as dev, but a SEPARATE database: note "instagram_e2e" at the end.
# The seed script refuses to run unless the database name ends with "_e2e".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/instagram_e2e?retryWrites=true

NODE_ENV=test

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# Optional in test: if SMTP is empty, OTP codes are only printed to the console
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E2E test users (created by npm run seed:e2e)
E2E_USER_PASSWORD=
